# No local neural model or embedding API key is needed.
KIRO_API_KEY=
SESSION_SECRET=
CHAT_BASE_URL=https://api.xkiro.com/v1
CHAT_MODEL=qwen/qwen3.8-omni-flash:free
CHAT_RESPONSE_FORMAT=prompt
QDRANT_COLLECTION=documents_bm25_v1
# For Render, set the Qdrant Cloud HTTPS URL and key in Environment.
# QDRANT_URL=https://your-cluster.cloud.qdrant.io
# QDRANT_API_KEY=
# BM25 scores are not cosine similarities. Zero keeps all term-matching hits.
MIN_RELEVANCE_SCORE=0
BM25_K1=1.2
BM25_B=0.75
BM25_AVG_LENGTH=220
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=100
# true on Render HTTPS; false for local HTTP.
COOKIE_SECURE=false
# Render supplies PORT=10000 automatically. Local Docker defaults to 8000.
