# Copy to .env. Never commit real keys.
KIRO_API_KEY=
SESSION_SECRET=
CHAT_BASE_URL=https://api.xkiro.com/v1
CHAT_MODEL=qwen/qwen3.8-omni-flash:free
# prompt: standard chat request, JSON enforced by prompt and server validation.
# json_object / json_schema: only if explicitly supported by your provider/model.
CHAT_RESPONSE_FORMAT=prompt
# Real local multilingual CPU embeddings. No OpenAI or Kiro embeddings key needed.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=/models
EMBEDDING_THREADS=2
# New collection because the previous version used incompatible 1536-dimensional vectors.
QDRANT_COLLECTION=documents_kiro_minilm_v1
MIN_RELEVANCE_SCORE=0.35
COOKIE_SECURE=false
